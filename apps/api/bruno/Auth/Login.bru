meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{testUserEmail}}",
    "password": "{{testUserPassword}}"
  }
}

script:post-response {
  const session = bru.cookies.get("BIFROST_SESSION");
  const xsrf = bru.cookies.get("XSRF-TOKEN");
  if (session) bru.setVar("authCookie", session);
  if (xsrf) bru.setVar("xsrfToken", xsrf);
}

docs {
  Public. Sets BIFROST_SESSION cookie (HttpOnly, Secure, SameSite=Lax, 7d)
  and XSRF-TOKEN cookie. Both are stored in the environment cookie jar
  and auto-sent on subsequent requests.
  200 on success, 401 on bad credentials, 403 if user is not ACTIVE.
  Run this BEFORE any protected request in the same collection run.
}

settings {
  encodeUrl: true
}
