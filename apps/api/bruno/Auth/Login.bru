meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{testUserEmail}}",
    "password": "{{testUserPassword}}"
  }
}

script:post-response {
  const session = bru.cookies.get("BIFROST_SESSION");
  if (session) bru.setVar("authCookie", session);
}

docs {
  Public. Sets the BIFROST_SESSION cookie (HttpOnly, Secure, SameSite=Lax, 7d).
  The cookie is stored in the environment cookie jar and auto-sent on subsequent requests.
  200 on success, 401 on bad credentials, 403 if user is not ACTIVE.
  Run this before protected requests. Run Get CSRF Token before protected mutations.
}

settings {
  encodeUrl: true
}
